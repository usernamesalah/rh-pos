# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=rh_pos
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# HashID Configuration
# Must be at least 16 characters. Changing this value invalidates all existing tokens and hashed IDs.
HASHID_SALT=__next_move_to_config__

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Storage Configuration
# Options: "local" (filesystem) or "minio" (object storage)
# Use "local" for development — no external service required.
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
# Base URL for serving local storage files (optional, defaults to http://localhost:PORT)
# STORAGE_BASE_URL=http://localhost:8080

# MinIO Configuration (required only when STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rh-pos
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_DEFAULT_EXPIRY=1h