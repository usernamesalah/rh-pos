# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=rh_pos
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# HashID Configuration
# Must be at least 16 characters. Changing this value invalidates all existing tokens and hashed IDs.
HASHID_SALT=__next_move_to_config__

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Storage Configuration
# Options: "local" (filesystem) or "s3" (S3-compatible object storage)
# Use "local" for development — no external service required.
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
# Base URL for serving local storage files (optional, defaults to http://localhost:PORT)
# STORAGE_BASE_URL=http://localhost:8080

# S3-compatible Storage Configuration (required only when STORAGE_TYPE=s3)
# Supported providers: MinIO, Cloudflare R2, AWS S3, DigitalOcean Spaces, Backblaze B2, etc.
# S3_ENDPOINT: Enter your S3-compatible endpoint URL
#   - MinIO: localhost:9000
#   - Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
#   - AWS S3: s3.amazonaws.com
#   - DigitalOcean Spaces: <region>.digitaloceanspaces.com
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rh-pos
S3_USE_SSL=false
S3_REGION=us-east-1
S3_DEFAULT_EXPIRY=1h